                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12px 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
