                                <Label style="-fx-text-fill: #10b981; -fx-font-size: 11px;" text="↑ 12% this week" />
                            </VBox>

                            <VBox spacing="4.0" style="-fx-background-color: #111827; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #1f2937; -fx-border-radius: 10px;" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-font-weight: bold;" text="ACTIVE COMPLETED TRIPS" />
