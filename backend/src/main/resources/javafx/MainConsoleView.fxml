                                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1f2937; -fx-padding: 10px 14px; -fx-background-radius: 8px;">
                                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Today's Gross Earnings:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblDriverEarnings" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="₹ 2,840.00" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1f2937; -fx-padding: 10px 14px; -fx-background-radius: 8px;">
                                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Partner Rating:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" text="★ 4.92 / 5.0" />
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Right: Live Ride Request Dispatch Radar -->
                            <VBox spacing="16.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="1">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Incoming Ride Dispatch Radar" />

                                <VBox fx:id="cardIncomingTrip" spacing="12.0" style="-fx-background-color: #1f2937; -fx-padding: 18px; -fx-background-radius: 10px; -fx-border-color: #4f46e5; -fx-border-radius: 10px; -fx-border-width: 1.5px;">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label style="-fx-background-color: #312e81; -fx-text-fill: #a5b4fc; -fx-padding: 3px 8px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: bold;" text="NEW TRIP DISPATCH" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblCountdownTimer" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 13px;" text="⏱ 14s auto-decline" />
                                    </HBox>
                                    
                                    <VBox spacing="4.0">
                                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-font-weight: bold;" text="RIDER &amp; ROUTE" />
                                        <Label fx:id="lblIncomingPassenger" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Priya Sharma (★ 4.95)" />
