            <Tab fx:id="tabDriver" text="🚕 Driver Terminal (8081)">
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #f8fafc; -fx-border-color: transparent;">
                    <VBox spacing="20.0" style="-fx-padding: 24px; -fx-background-color: #f8fafc;">
                        <!-- Header Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="toury-card" style="-fx-padding: 16px 20px; -fx-border-left-color: #10b981; -fx-border-left-width: 4px;">
                            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Driver Captain Dispatch Workspace" />
