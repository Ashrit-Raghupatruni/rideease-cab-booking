                                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #991b1b;" text="Emergency SOS Center" />
                                        <Label style="-fx-font-size: 10px; -fx-text-fill: #7f1d1d;" text="24x7 Safety Assistance &amp; Live Tracking" />
