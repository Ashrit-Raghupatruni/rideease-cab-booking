                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Plan Your Journey" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Search nearby cabs, compare Mini, Sedan, and SUV fares, and track live drivers with GPS routing." />
                            </VBox>
                            <Button fx:id="btnLaunchRider" style="-fx-background-color: #f1f5f9; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;" text="↗ Launch in Web Browser (8080)" />
