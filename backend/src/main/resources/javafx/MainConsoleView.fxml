                            <VBox spacing="6.0" styleClass="toury-card" style="-fx-padding: 18px;" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="COMPLETED TRIPS" />
                                <Label fx:id="lblKpiTrips" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0284c7;" text="1,492" />
                                <Label style="-fx-text-fill: #16a34a; -fx-font-size: 11px; -fx-font-weight: bold;" text="99.4% completion rate" />
                            </VBox>

                            <VBox spacing="6.0" styleClass="toury-card" style="-fx-padding: 18px;" GridPane.columnIndex="2">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="PENDING VERIFICATIONS" />
                                <Label fx:id="lblKpiPending" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="1" />
                                <Label style="-fx-text-fill: #d97706; -fx-font-size: 11px; -fx-font-weight: bold;" text="Requires review" />
                            </VBox>

                            <VBox spacing="6.0" styleClass="toury-card" style="-fx-padding: 18px;" GridPane.columnIndex="3">
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="TOTAL GROSS REVENUE" />
                                <Label fx:id="lblKpiRevenue" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="₹ 3,42,850" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Platform commission: 15%" />
                            </VBox>
                        </GridPane>

                        <!-- Responsive 2-Chart Layout -->
                        <GridPane hgap="24.0" vgap="24.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <VBox minHeight="340.0" spacing="12.0" styleClass="toury-card" style="-fx-padding: 20px;" GridPane.columnIndex="0" VBox.vgrow="ALWAYS">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Compliance Verification Distribution" />
                                <PieChart fx:id="fleetDistributionChart" legendVisible="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
                            </VBox>

                            <VBox minHeight="340.0" spacing="12.0" styleClass="toury-card" style="-fx-padding: 20px;" GridPane.columnIndex="1" VBox.vgrow="ALWAYS">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Fleet Capacity by Vehicle Tier" />
                                <BarChart fx:id="bookingsBarChart" legendVisible="false" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <xAxis>
                                        <CategoryAxis label="Vehicle Tier" tickLabelFill="#64748b" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Fleet Units" tickLabelFill="#64748b" />
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ========================================== -->
            <!-- TAB 4: COMPLIANCE DOSSIER (Matching Web Admin Verifications) -->
            <!-- ========================================== -->
            <Tab text="📄 Compliance Dossier (TableView &amp; Photos)">
                <VBox spacing="16.0" style="-fx-background-color: #f8fafc; -fx-padding: 20px;">
                    <!-- Filter Toolbar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toury-card" style="-fx-padding: 12px 18px;">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12px;" text="SEARCH:" />
                        <TextField fx:id="searchField" prefWidth="260.0" promptText="Search name, license, plate, or car..." />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12px;" text="STATUS:" />
                        <ComboBox fx:id="statusFilterCombo" prefWidth="150.0" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12px;" text="CATEGORY:" />
                        <ComboBox fx:id="categoryFilterCombo" prefWidth="150.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ProgressBar fx:id="actionProgressBar" prefWidth="120.0" visible="false" />
                    </HBox>

                    <!-- SplitPane with Clean White Theme -->
                    <SplitPane dividerPositions="0.65" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
                        <!-- Table Card -->
                        <VBox minWidth="400.0" styleClass="toury-card" style="-fx-padding: 10px;">
                            <TableView fx:id="driversTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colDriverId" prefWidth="85.0" text="Driver ID" />
                                    <TableColumn fx:id="colDriverName" prefWidth="130.0" text="Driver Name" />
                                    <TableColumn fx:id="colLicense" prefWidth="120.0" text="License Plate" />
                                    <TableColumn fx:id="colCategory" prefWidth="75.0" text="Category" />
                                    <TableColumn fx:id="colVehicleModel" prefWidth="130.0" text="Vehicle Model" />
                                    <TableColumn fx:id="colPlate" prefWidth="110.0" text="Reg Plate" />
                                    <TableColumn fx:id="colStatus" prefWidth="95.0" text="Status" />
                                    <TableColumn fx:id="colRating" prefWidth="65.0" text="Rating" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- Document Details & Photo Inspection Card -->
                        <VBox minWidth="320.0" spacing="14.0" styleClass="toury-card" style="-fx-padding: 20px;">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Driver Compliance Dossier" />
                            <HBox alignment="CENTER" style="-fx-padding: 12px; -fx-background-color: #f1f5f9; -fx-background-radius: 12px;">
                                <ImageView fx:id="driverPhotoView" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
                            </HBox>
                            <VBox spacing="6.0">
                                <Label fx:id="selectedDriverLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Select a driver from the table" />
                                <Label fx:id="selectedPlateLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Vehicle Details" />
                                <HBox spacing="8.0">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="Current Status:" />
                                    <Label fx:id="selectedStatusLabel" style="-fx-font-weight: bold; -fx-text-fill: #4f46e5; -fx-font-size: 12px;" text="N/A" />
                                </HBox>
                                <Label fx:id="statusNoteLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Select driver to inspect Cloudinary-stored documents." wrapText="true" />
                            </VBox>
                            <Region VBox.vgrow="ALWAYS" />
                            <VBox spacing="10.0">
                                <Button fx:id="approveButton" maxWidth="Infinity" styleClass="btn-success" text="✓ Approve Driver &amp; Vehicle" />
                                <Button fx:id="rejectButton" maxWidth="Infinity" styleClass="btn-danger" text="✕ Reject with Feedback" />
                            </VBox>
                        </VBox>
                    </SplitPane>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
