                                <VBox spacing="6.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;" text="PICKUP LOCATION" />
                                    <TextField fx:id="txtRiderPickup" promptText="Enter pickup spot..." text="Visakhapatnam Beach Road" />
                                </VBox>

                                <VBox spacing="6.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;" text="DESTINATION DROP-OFF" />
                                    <TextField fx:id="txtRiderDrop" promptText="Enter destination..." text="Rushikonda IT Park" />
                                </VBox>

                                <VBox spacing="8.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;" text="SELECT VEHICLE TIER" />
                                    <HBox spacing="12.0">
                                        <Button fx:id="btnTierMini" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-padding: 12px; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚗 Mini&#10;Affordable, compact" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnTierSedan" maxWidth="Infinity" style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-padding: 12px; -fx-background-radius: 12px; -fx-border-color: #6366f1; -fx-border-radius: 12px; -fx-border-width: 2px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚙 Sedan&#10;Comfortable sedans" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnTierSuv" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-padding: 12px; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚐 SUV&#10;Spacious 6-seater" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </VBox>

                                <Button fx:id="btnCalculateFare" maxWidth="Infinity" styleClass="btn-primary" text="⚡ Calculate OSRM Route &amp; Tariff" />
                            </VBox>

                            <!-- Right: Upfront Tariff Card & Instant Dispatch Status -->
                            <VBox spacing="16.0" styleClass="toury-card" style="-fx-padding: 24px;" GridPane.columnIndex="1">
