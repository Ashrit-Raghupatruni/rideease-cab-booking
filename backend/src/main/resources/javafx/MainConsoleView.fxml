                            <Button fx:id="btnLaunchAdmin" style="-fx-background-color: #1f2937; -fx-text-fill: #f87171; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-border-color: #991b1b; -fx-border-radius: 8px;" text="↗ Open in Web Browser (8082)" />
