                        <!-- Driver Header Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #111827; -fx-padding: 16px 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Driver Partner Dispatch Terminal" />
