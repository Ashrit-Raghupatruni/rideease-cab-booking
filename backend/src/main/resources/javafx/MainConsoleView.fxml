                                <VBox fx:id="cardIncomingTrip" spacing="14.0" style="-fx-background-color: #fdf4ff; -fx-padding: 20px; -fx-background-radius: 14px; -fx-border-color: #f0abfc; -fx-border-radius: 14px; -fx-border-width: 1.5px;">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label style="-fx-background-color: #fae8ff; -fx-text-fill: #a21caf; -fx-padding: 4px 10px; -fx-background-radius: 6px; -fx-font-size: 11px; -fx-font-weight: bold;" text="NEW TRIP OFFER" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblCountdownTimer" style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 13px;" text="⏱ 14s auto-decline" />
                                    </HBox>
                                    
                                    <VBox spacing="4.0">
                                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" text="PASSENGER &amp; ROUTE" />
