                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <!-- Left Card: Origin, Destination & Vehicle Selection -->
                            <VBox spacing="16.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="0">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Trip Route &amp; Ride Tier" />
                                
                                <VBox spacing="6.0">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;" text="PICKUP LOCATION" />
                                    <TextField fx:id="txtRiderPickup" promptText="e.g. Visakhapatnam Beach Road" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #374151; -fx-border-radius: 8px;" text="Visakhapatnam Beach Road" />
                                </VBox>

                                <VBox spacing="6.0">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;" text="DESTINATION DROP-OFF" />
                                    <TextField fx:id="txtRiderDrop" promptText="e.g. Rushikonda IT Park" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #374151; -fx-border-radius: 8px;" text="Rushikonda IT Park" />
                                </VBox>

                                <VBox spacing="6.0">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: bold;" text="SELECT VEHICLE CATEGORY" />
                                    <HBox spacing="10.0">
                                        <Button fx:id="btnTierMini" maxWidth="Infinity" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #374151; -fx-border-radius: 8px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚗 MINI" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnTierSedan" maxWidth="Infinity" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #6366f1; -fx-border-radius: 8px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚙 SEDAN" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnTierSuv" maxWidth="Infinity" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: #374151; -fx-border-radius: 8px; -fx-font-weight: bold; -fx-cursor: hand;" text="🚐 SUV" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </VBox>

                                <Button fx:id="btnCalculateFare" maxWidth="Infinity" style="-fx-background-color: #3730a3; -fx-text-fill: #e0e7ff; -fx-padding: 10px; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-cursor: hand;" text="Calculate OSRM Route &amp; Tariff" />
                            </VBox>

                            <!-- Right Card: Instant Fare Breakdown & Book Action -->
                            <VBox spacing="16.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="1">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Tariff Estimate &amp; Dispatch Status" />

                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #1e1b4b; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #312e81; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #a5b4fc; -fx-font-weight: bold;" text="ESTIMATED FARE (SEDAN)" />
                                        <Label fx:id="lblFareAmount" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" text="₹ 245.00" />
                                    </VBox>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                        <Label fx:id="lblDistance" style="-fx-font-size: 13px; -fx-text-fill: #e2e8f0; -fx-font-weight: bold;" text="Distance: 12.4 km" />
                                        <Label fx:id="lblDuration" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" text="Est. Time: ~24 mins" />
                                    </VBox>
                                </HBox>

                                <!-- Active Ride Lifecycle Card -->
                                <VBox fx:id="cardRideLifecycle" spacing="8.0" style="-fx-background-color: #1f2937; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #374151; -fx-border-radius: 8px;">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 13px;" text="● RIDE STATUS:" />
