<BorderPane stylesheets="@toury-fx.css" prefHeight="820.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rideease.javafx.controller.MainConsoleController">
    <!-- Top Modern Navigation Bar (Matching Web Navbar bg-gradient-toury) -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #4f46e5, #7c3aed); -fx-padding: 12px 24px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 22px;" text="🚗" />
                    <VBox spacing="1.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;" text="RideEase" />
                            <Label style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 2px 8px; -fx-background-radius: 10px;" text="Unified Edition" />
                        </HBox>
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #e0e7ff;" text="Multi-Port Native Dispatch &amp; Command Center" />
                    </VBox>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <!-- Web Port Status Badges -->
                <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(15, 23, 42, 0.25); -fx-padding: 5px 14px; -fx-background-radius: 20px;">
                    <Label fx:id="lblStatus8080" style="-fx-text-fill: #34d399; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8080 Rider" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11px;" text="|" />
                    <Label fx:id="lblStatus8081" style="-fx-text-fill: #34d399; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8081 Driver" />
                    <Label style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11px;" text="|" />
                    <Label fx:id="lblStatus8082" style="-fx-text-fill: #34d399; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8082 Admin" />
                </HBox>
                
                <Button fx:id="refreshButton" style="-fx-background-color: white; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 6px 16px; -fx-cursor: hand;" text="↻ Refresh System" />
            </HBox>
        </VBox>
    </top>

    <!-- Main Navigation TabPane (White Background, Purple Active Bar matching Web Tabs) -->
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-background-color: #f8fafc;" tabClosingPolicy="UNAVAILABLE">
            
            <!-- ========================================== -->
