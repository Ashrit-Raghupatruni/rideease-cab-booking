                                    <Button fx:id="btnSosEmergency" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-cursor: hand;" text="🚨 SOS Call (112)" />
                                </HBox>

                                <HBox spacing="12.0">
                                    <Button fx:id="btnBookRide" maxWidth="Infinity" styleClass="btn-success" style="-fx-font-size: 14px; -fx-padding: 12px;" text="⚡ Book Instant Ride" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelRide" styleClass="btn-danger" style="-fx-padding: 12px 18px;" text="Cancel" />
                                </HBox>
