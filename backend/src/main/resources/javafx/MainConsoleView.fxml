                <!-- Status Badges for all 3 Ports -->
                <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #1f2937; -fx-padding: 4px 12px; -fx-background-radius: 20px;">
                    <Label style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8080 Rider" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="|" />
                    <Label style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8081 Driver" />
                    <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="|" />
                    <Label style="-fx-text-fill: #10b981; -fx-font-size: 11px; -fx-font-weight: bold;" text="● 8082 Admin" />
                </HBox>
                
                <Button fx:id="refreshButton" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 7px 16px; -fx-cursor: hand;" text="↻ Refresh System" />
            </HBox>
        </VBox>
    </top>

