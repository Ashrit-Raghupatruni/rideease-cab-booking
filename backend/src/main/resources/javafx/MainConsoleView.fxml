                                        <Button fx:id="btnAcceptRide" maxWidth="Infinity" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="✓ Accept Ride" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnDeclineRide" maxWidth="Infinity" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="✕ Decline" HBox.hgrow="ALWAYS" />
