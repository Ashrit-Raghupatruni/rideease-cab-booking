                            <VBox spacing="4.0" style="-fx-background-color: #111827; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #1f2937; -fx-border-radius: 10px;" GridPane.columnIndex="2">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-font-weight: bold;" text="PENDING VERIFICATIONS" />
                                <Label fx:id="lblKpiPending" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #fbbf24;" text="1" />
                                <Label style="-fx-text-fill: #fbbf24; -fx-font-size: 11px;" text="Requires admin review" />
                            </VBox>

                            <VBox spacing="4.0" style="-fx-background-color: #111827; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #1f2937; -fx-border-radius: 10px;" GridPane.columnIndex="3">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-font-weight: bold;" text="TOTAL GROSS REVENUE" />
                                <Label fx:id="lblKpiRevenue" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #34d399;" text="₹ 3,42,850" />
                                <Label style="-fx-text-fill: #10b981; -fx-font-size: 11px;" text="Platform commission: 15%" />
                            </VBox>
                        </GridPane>

                        <!-- Responsive 2-Chart Layout -->
                        <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>

                            <VBox minHeight="340.0" spacing="12.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="0" VBox.vgrow="ALWAYS">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Fleet Compliance Status Distribution" />
                                <PieChart fx:id="fleetDistributionChart" legendVisible="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
                            </VBox>

                            <VBox minHeight="340.0" spacing="12.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="1" VBox.vgrow="ALWAYS">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Fleet Capacity by Vehicle Tier" />
                                <BarChart fx:id="bookingsBarChart" legendVisible="false" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <xAxis>
                                        <CategoryAxis label="Vehicle Tier" tickLabelFill="#9ca3af" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Fleet Units" tickLabelFill="#9ca3af" />
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- TAB 4: COMPLIANCE DOSSIER & DOCUMENT INSPECTION -->
            <Tab text="📄 Compliance Dossier (TableView &amp; Photos)">
                <VBox spacing="14.0" style="-fx-background-color: #0b0f19; -fx-padding: 16px;">
                    <!-- Filter Toolbar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #111827; -fx-padding: 12px 16px; -fx-background-radius: 10px; -fx-border-color: #1f2937; -fx-border-radius: 10px;">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="SEARCH:" />
                        <TextField fx:id="searchField" prefWidth="260.0" promptText="Search name, license, plate, or car..." style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6px; -fx-border-color: #374151; -fx-border-radius: 6px;" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="STATUS:" />
                        <ComboBox fx:id="statusFilterCombo" prefWidth="150.0" style="-fx-background-color: #1f2937; -fx-border-color: #374151; -fx-border-radius: 6px;" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="CATEGORY:" />
                        <ComboBox fx:id="categoryFilterCombo" prefWidth="150.0" style="-fx-background-color: #1f2937; -fx-border-color: #374151; -fx-border-radius: 6px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ProgressBar fx:id="actionProgressBar" prefWidth="120.0" visible="false" />
                    </HBox>

                    <!-- SplitPane with responsive constraints -->
                    <SplitPane dividerPositions="0.65" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
                        <!-- Table Column -->
                        <VBox minWidth="400.0" style="-fx-background-color: #111827; -fx-background-radius: 10px; -fx-border-color: #1f2937; -fx-border-radius: 10px; -fx-padding: 8px;">
                            <TableView fx:id="driversTableView" style="-fx-background-color: #111827;" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colDriverId" prefWidth="85.0" text="Driver ID" />
                                    <TableColumn fx:id="colDriverName" prefWidth="130.0" text="Driver Name" />
                                    <TableColumn fx:id="colLicense" prefWidth="120.0" text="License Plate" />
                                    <TableColumn fx:id="colCategory" prefWidth="75.0" text="Category" />
                                    <TableColumn fx:id="colVehicleModel" prefWidth="130.0" text="Vehicle Model" />
                                    <TableColumn fx:id="colPlate" prefWidth="110.0" text="Reg Plate" />
                                    <TableColumn fx:id="colStatus" prefWidth="95.0" text="Status" />
                                    <TableColumn fx:id="colRating" prefWidth="65.0" text="Rating" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- Document Details & Photo Inspection Card -->
                        <VBox minWidth="320.0" spacing="14.0" style="-fx-background-color: #111827; -fx-padding: 18px; -fx-border-color: #1f2937; -fx-border-radius: 10px; -fx-background-radius: 10px;">
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Driver &amp; Vehicle Compliance Dossier" />
                            <HBox alignment="CENTER" style="-fx-padding: 10px; -fx-background-color: #1f2937; -fx-background-radius: 10px; -fx-border-color: #374151; -fx-border-radius: 10px;">
                                <ImageView fx:id="driverPhotoView" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
                            </HBox>
                            <VBox spacing="6.0">
                                <Label fx:id="selectedDriverLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Select a driver from the table" />
                                <Label fx:id="selectedPlateLabel" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="Vehicle Details" />
                                <HBox spacing="8.0">
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #cbd5e1; -fx-font-size: 12px;" text="Current Status:" />
                                    <Label fx:id="selectedStatusLabel" style="-fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-font-size: 12px;" text="N/A" />
                                </HBox>
                                <Label fx:id="statusNoteLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Select driver to inspect Cloudinary-stored documents." wrapText="true" />
                            </VBox>
                            <Region VBox.vgrow="ALWAYS" />
                            <VBox spacing="8.0">
                                <Button fx:id="approveButton" maxWidth="Infinity" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="✓ Approve Driver &amp; Vehicle" />
                                <Button fx:id="rejectButton" maxWidth="Infinity" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="✕ Reject with Feedback" />
                            </VBox>
                        </VBox>
                    </SplitPane>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
