<BorderPane prefHeight="820.0" prefWidth="1200.0" style="-fx-background-color: #0b0f19; -fx-font-family: 'Segoe UI', system-ui, sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rideease.javafx.controller.MainConsoleController">
    <!-- Top Modern Application Bar -->
    <top>
        <VBox style="-fx-background-color: #111827; -fx-padding: 14px 24px; -fx-border-color: #1f2937; -fx-border-width: 0 0 1px 0;">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 6px 10px; -fx-background-radius: 8px; -fx-font-weight: bold;" text="RE" />
                    <VBox spacing="1.0">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="RideEase Unified Command Console" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" text="Multi-Port Native Dispatch &amp; Operations Center" />
                    </VBox>
                </HBox>
                <Label style="-fx-background-color: #1e1b4b; -fx-text-fill: #a5b4fc; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-border-color: #3730a3; -fx-border-radius: 12px;" text="JavaFX Desktop Native" />
