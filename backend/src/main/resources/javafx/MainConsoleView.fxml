                            <Button fx:id="btnLaunchDriver" style="-fx-background-color: #1f2937; -fx-text-fill: #34d399; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-border-color: #065f46; -fx-border-radius: 8px;" text="↗ Open in Web Browser (8081)" />
                        </HBox>

                        <!-- Driver Dynamic Panels: Duty Control + Radar Ride Dispatch -->
                        <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="40.0" />
                                <ColumnConstraints percentWidth="60.0" />
                            </columnConstraints>

                            <!-- Left: Duty Status & Shift Counters -->
                            <VBox spacing="16.0" style="-fx-background-color: #111827; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-color: #1f2937; -fx-border-radius: 12px;" GridPane.columnIndex="0">
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" text="Shift &amp; Duty Controls" />
                                
                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #064e3b; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #047857; -fx-border-radius: 8px;">
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #a7f3d0; -fx-font-weight: bold;" text="CURRENT SHIFT DUTY" />
                                        <Label fx:id="lblDriverDutyStatus" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34d399;" text="ONLINE (Ready for Rides)" />
                                    </VBox>
                                    <Button fx:id="btnToggleDuty" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Go Offline" />
