                                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f0fdf4; -fx-padding: 16px; -fx-background-radius: 12px; -fx-border-color: #bbf7d0; -fx-border-radius: 12px;">
