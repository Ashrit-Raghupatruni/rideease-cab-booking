                                    </HBox>
                                    <Label fx:id="lblAssignedDriver" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;" text="Nearby Drivers Available: 4 active in zone" />
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" text="Trip OTP:" />
                                        <Label fx:id="lblRiderOtp" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f59e0b; -fx-background-color: #312e81; -fx-padding: 2px 8px; -fx-background-radius: 4px;" text="7429" />
                                    </HBox>
                                </VBox>

                                <HBox spacing="10.0">
                                    <Button fx:id="btnBookRide" maxWidth="Infinity" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-font-size: 14px;" text="⚡ Book Instant Cab Now" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelRide" style="-fx-background-color: #374151; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-padding: 12px 16px; -fx-background-radius: 8px; -fx-cursor: hand;" text="Cancel" />
                                </HBox>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
