                                <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #f0fdf4; -fx-padding: 16px; -fx-background-radius: 12px; -fx-border-color: #bbf7d0; -fx-border-radius: 12px;">
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #15803d; -fx-font-weight: bold;" text="GUARANTEED UPFRONT FARE" />
                                        <Label fx:id="lblFareAmount" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="₹ 245.00" />
                                    </VBox>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                        <Label fx:id="lblDistance" style="-fx-font-size: 13px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="Distance: 12.4 km" />
                                        <Label fx:id="lblDuration" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Est. Time: ~24 mins" />
                                    </VBox>
                                </HBox>

                                <!-- Interactive Visual Map Canvas -->
                                <VBox spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-padding: 12px; -fx-background-radius: 12px; -fx-border-color: #cbd5e1; -fx-border-radius: 12px;">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-font-size: 12px;" text="🗺️ Interactive Visual GPS Map" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblMapScanningStatus" style="-fx-font-size: 11px; -fx-text-fill: #16a34a; -fx-font-weight: bold;" text="● 4 Captains Live Scanning" />
                                    </HBox>
                                    <javafx.scene.canvas.Canvas fx:id="routeMapCanvas" height="150.0" width="500.0" />
                                </VBox>

                                <!-- Active Ride Lifecycle Card -->
                                <VBox fx:id="cardRideLifecycle" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 16px; -fx-background-radius: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px;">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 13px;" text="● RIDE STATUS:" />
                                        <Label fx:id="lblRiderBookingStatus" style="-fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-font-size: 13px;" text="READY FOR DISPATCH" />
                                    </HBox>
                                    <Label fx:id="lblAssignedDriver" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Scanning for nearest verified drivers..." />
                                    
                                    <!-- Secret OTP: Visible ONLY when driver accepts -->
                                    <HBox fx:id="boxOtpContainer" alignment="CENTER_LEFT" spacing="10.0" visible="false" managed="false" style="-fx-background-color: #fef3c7; -fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-border-color: #fde68a; -fx-border-radius: 8px;">
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #92400e; -fx-font-weight: bold;" text="Share OTP with Captain on Arrival:" />
                                        <Label fx:id="lblRiderOtp" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b45309; -fx-background-color: white; -fx-padding: 2px 10px; -fx-background-radius: 6px; -fx-border-color: #f59e0b; -fx-border-radius: 6px;" text="----" />
                                    </HBox>
                                </VBox>

                                <!-- SOS & Safety Emergency Quick Action Strip -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #fee2e2; -fx-padding: 10px 14px; -fx-background-radius: 10px; -fx-border-color: #fca5a5; -fx-border-radius: 10px;">
                                    <Label style="-fx-font-size: 16px;" text="🛡️" />
