# RideEase Environment Configuration Template
# Copy this file to .env and supply actual values for your deployment
# NEVER commit .env to version control

# Server Ports
PORT=8080
DRIVER_PORT=8081
ADMIN_PORT=8082

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rideease_db?retryWrites=true&w=majority&appName=Cluster0&tls=true
SPRING_DATA_MONGODB_URI=

# JWT Configuration (Must be at least 256-bit / 32 bytes secret)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Cloudinary Storage Configuration
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Routing & Mapping API Keys
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Initial Administrator Bootstrap (Optional)
# If provided, an administrator account is initialized on startup if none exists.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
