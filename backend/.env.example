# RideEase Environment Configuration Template
# Copy this file to .env and supply actual values for your deployment
# NEVER commit .env to version control

# Server Ports
PORT=8080
PORT_DRIVER=8081
PORT_ADMIN=8082

# MySQL Relational Database Configuration
# Default connection string connects to local MySQL service (e.g. MYSQL80 on port 3306)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/rideease_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Configuration (Must be at least 256-bit / 32 bytes secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Cloudinary Storage Configuration (for Driver & Vehicle Documents)
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Routing & Mapping API Keys
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Initial Administrator Bootstrap (Optional)
ADMIN_INITIAL_EMAIL=admin@rideease.com
ADMIN_INITIAL_PASSWORD=admin123
