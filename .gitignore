# Git Ignore for RideEase Project

# Target and build directories
target/
**/target/
build/
**/build/
.gradle/
**/.gradle/

# Environment files and credentials
*.env
**/.env
.env.*
!.env.example

# IDE and Editor files
.idea/
**/.idea/
*.iml
**/*.iml
.vscode/
**/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
**/logs/

# Node modules
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS specific files
desktop.ini
